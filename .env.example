# Environment Variables
#
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real credentials.

# ─── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database Architecture (PostgreSQL) ──────────────────────
# Provide connection string for production PostgreSQL instance.
# (If omitted in local development/testing, falls back gracefully to local store)
DATABASE_URL=postgresql://user:password@localhost:5432/rawreply

# ─── JWT Authentication & Cryptography ───────────────────────
# 32-byte secret key used for signing JWT access tokens (HS256)
JWT_ACCESS_SECRET=your_32_byte_jwt_access_secret_key_here
JWT_ISSUER=rawreply
JWT_AUDIENCE=rawreply-api

# 32-byte hex key used for AES-256-GCM token encryption at rest
ENCRYPTION_SECRET=your_32_byte_hex_encryption_secret_here

# ─── Meta / Instagram Graph API v21.0 ──────────────────────────
# Facebook App ID and App Secret from Meta Developer Dashboard (developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
# Explicit redirect URI registered in Meta App Settings (defaults to ${NEXT_PUBLIC_APP_URL}/api/auth/meta/callback)
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
# Meta Graph API version (default: v21.0)
META_API_VERSION=v21.0
# Secret verification token for Instagram webhook subscriptions (configured in Meta Webhooks panel)
META_WEBHOOK_VERIFY_TOKEN=

# ─── Email Provider (Password Reset & Verification) ──────────
EMAIL_PROVIDER=
EMAIL_FROM=RawReply Security <noreply@rawreply.io>
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# ─── Microsoft Excel / Microsoft Graph API ────────────────────
# Application (client) ID and Client Secret from Microsoft Entra / Azure Portal
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Redirect URI registered in Microsoft Entra ID (defaults to ${NEXT_PUBLIC_APP_URL}/api/auth/microsoft/callback)
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

